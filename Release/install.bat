@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "DGB_INSTALL_DIR=%~dp0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "DGB_RESULT=%ERRORLEVEL%"
echo.
if "%DGB_RESULT%"=="0" (
  echo Installation finished. Open Xbox Game Bar with Win+G.
) else (
  echo Installation failed. See the message above.
)
pause
exit /b %DGB_RESULT%
