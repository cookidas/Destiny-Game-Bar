<Page
    x:Class="DimGameBar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark"
    Loaded="OnLoaded">
    <Page.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <Grid Background="#17191D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="BackButton" Click="GoBack" IsEnabled="False"
                        Style="{StaticResource ToolbarButton}" AutomationProperties.Name="뒤로 가기"
                        ToolTipService.ToolTip="뒤로 가기 (Alt+왼쪽 화살표)">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button x:Name="ForwardButton" Click="GoForward" IsEnabled="False"
                        Style="{StaticResource ToolbarButton}" AutomationProperties.Name="앞으로 가기"
                        ToolTipService.ToolTip="앞으로 가기 (Alt+오른쪽 화살표)">
                    <SymbolIcon Symbol="Forward" />
                </Button>
                <Button x:Name="ReloadButton" Click="Reload" IsEnabled="False"
                        Style="{StaticResource ToolbarButton}" AutomationProperties.Name="새로고침"
                        ToolTipService.ToolTip="새로고침 (Ctrl+R)">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Border Width="1" Background="#50545B" Margin="4,8" />
            </StackPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ShortcutBar" Orientation="Horizontal" Spacing="4" />
            </ScrollViewer>
            <Button Grid.Column="2" Style="{StaticResource ToolbarButton}"
                    AutomationProperties.Name="바로가기 설정" ToolTipService.ToolTip="바로가기 설정">
                <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#x22EE;" FontSize="24" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <ScrollViewer MaxHeight="380" Width="260"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ShortcutOptions" Spacing="4" />
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="12,4,12,8"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
        <controls:WebView2 x:Name="Browser" Grid.Row="2"
                           AutomationProperties.Name="DIM 인벤토리" />
    </Grid>
</Page>
